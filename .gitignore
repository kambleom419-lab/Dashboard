# ============================================================
# .gitignore  -  rules for what is NOT pushed
# ============================================================

# ---- 1. Assignment briefs (not part of the deliverable) ----
ASSIGNMENT 02.pdf
ASSIGNMENT 03.pdf

# ---- 2. Raw datasets ----
*.xlsx
*.xls
*.csv

# ---- 3. Command Code agent files (taste.md lives in .commandcode/) ----
.commandcode/
taste.md

# ---- 4. Office / Power BI temp and lock files ----
~$*
*.pbix~
*.tmp

# ---- 5. OS junk ----
Thumbs.db
.DS_Store
desktop.ini
